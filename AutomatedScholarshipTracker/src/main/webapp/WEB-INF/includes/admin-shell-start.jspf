<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<nav class="navbar">
    <div class="navbar-inner">
        <a href="${pageContext.request.contextPath}/admin/dashboard" class="navbar-brand" style="text-decoration:none;">
            <span class="brand-badge">SD</span> ScholarTrack <span style="color:#d97b3f;font-size:12px;font-weight:800;margin-left:6px;">ADMIN</span>
        </a>
        <div class="navbar-user">
            <span class="name">${sessionScope.user.fullName}</span>
            <a href="${pageContext.request.contextPath}/logout" class="btn btn-secondary btn-sm">Logout</a>
        </div>
    </div>
</nav>
<div class="app-shell">
    <aside class="sidebar">
        <div class="sidebar-section-title">Admin Menu</div>
        <a class="sidebar-link ${pageName == 'dashboard' ? 'active' : ''}" href="${pageContext.request.contextPath}/admin/dashboard">Dashboard</a>
        <a class="sidebar-link ${pageName == 'scholarships' ? 'active' : ''}" href="${pageContext.request.contextPath}/admin/scholarships">Scholarships</a>
        <a class="sidebar-link ${pageName == 'add-scholarship' ? 'active' : ''}" href="${pageContext.request.contextPath}/admin/add-scholarship">Add Scholarship</a>
        <a class="sidebar-link ${pageName == 'students' ? 'active' : ''}" href="${pageContext.request.contextPath}/admin/students">Students</a>
        <a class="sidebar-link ${pageName == 'applications' ? 'active' : ''}" href="${pageContext.request.contextPath}/admin/applications">Applications</a>
        <div class="sidebar-section-title">Account</div>
        <a class="sidebar-link" href="${pageContext.request.contextPath}/logout">Logout</a>
    </aside>
    <main class="main-content">
