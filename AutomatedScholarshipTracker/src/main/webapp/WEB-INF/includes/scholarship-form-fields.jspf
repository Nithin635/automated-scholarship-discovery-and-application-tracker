<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<h4 style="margin-top:0;">Basic Information</h4>
<div class="form-grid">
    <div class="form-group">
        <label for="name">Scholarship Name</label>
        <input type="text" id="name" name="name" data-required="true" required value="${scholarship.name}">
    </div>
    <div class="form-group">
        <label for="provider">Provider</label>
        <input type="text" id="provider" name="provider" data-required="true" required value="${scholarship.provider}">
    </div>
    <div class="form-group">
        <label for="scholarshipType">Scholarship Type</label>
        <select id="scholarshipType" name="scholarshipType">
            <option value="GOVERNMENT" ${scholarship.scholarshipType == 'GOVERNMENT' ? 'selected' : ''}>Government</option>
            <option value="PRIVATE" ${scholarship.scholarshipType == 'PRIVATE' ? 'selected' : ''}>Private</option>
            <option value="INSTITUTIONAL" ${scholarship.scholarshipType == 'INSTITUTIONAL' ? 'selected' : ''}>Institutional</option>
            <option value="NGO" ${scholarship.scholarshipType == 'NGO' ? 'selected' : ''}>NGO</option>
        </select>
    </div>
    <div class="form-group">
        <label for="amount">Amount (display text, e.g. "₹50,000 per year")</label>
        <input type="text" id="amount" name="amount" value="${scholarship.amount}">
    </div>
    <div class="form-group">
        <label for="status">Status</label>
        <select id="status" name="status">
            <option value="ACTIVE" ${scholarship.status == 'ACTIVE' ? 'selected' : ''}>Active</option>
            <option value="INACTIVE" ${scholarship.status == 'INACTIVE' ? 'selected' : ''}>Inactive</option>
        </select>
    </div>
</div>
<div class="form-group">
    <label for="description">Description</label>
    <textarea id="description" name="description" rows="3">${scholarship.description}</textarea>
</div>
<div class="form-group">
    <label for="eligibilityDescription">Eligibility Description (free text summary shown to students)</label>
    <textarea id="eligibilityDescription" name="eligibilityDescription" rows="2">${scholarship.eligibilityDescription}</textarea>
</div>

<h4>Eligibility Rules (used by the automated eligibility engine)</h4>
<div class="form-grid">
    <div class="form-group">
        <label for="minimumCgpa">Minimum CGPA (blank = unrestricted)</label>
        <input type="number" step="0.01" min="0" max="10" id="minimumCgpa" name="minimumCgpa" value="${scholarship.minimumCgpa}">
    </div>
    <div class="form-group">
        <label for="minimumPercentage">Minimum Percentage (blank = unrestricted)</label>
        <input type="number" step="0.01" min="0" max="100" id="minimumPercentage" name="minimumPercentage" value="${scholarship.minimumPercentage}">
    </div>
    <div class="form-group">
        <label for="maximumFamilyIncome">Maximum Family Income ₹ (blank = unrestricted)</label>
        <input type="number" min="0" id="maximumFamilyIncome" name="maximumFamilyIncome" value="${scholarship.maximumFamilyIncome}">
    </div>
    <div class="form-group">
        <label for="eligibleCategories">Eligible Categories (comma-separated, or ALL)</label>
        <input type="text" id="eligibleCategories" name="eligibleCategories" placeholder="ALL or OBC,SC,ST" value="${scholarship.eligibleCategories}">
    </div>
    <div class="form-group">
        <label for="eligibleCourses">Eligible Courses (comma-separated, or ALL)</label>
        <input type="text" id="eligibleCourses" name="eligibleCourses" placeholder="ALL or Engineering,Diploma" value="${scholarship.eligibleCourses}">
    </div>
    <div class="form-group">
        <label for="eligibleStates">Eligible States (comma-separated, or ALL)</label>
        <input type="text" id="eligibleStates" name="eligibleStates" placeholder="ALL or Karnataka,Kerala" value="${scholarship.eligibleStates}">
    </div>
    <div class="form-group">
        <label for="minimumYear">Minimum Year of Study (blank = unrestricted)</label>
        <input type="number" min="1" max="6" id="minimumYear" name="minimumYear" value="${scholarship.minimumYear}">
    </div>
    <div class="form-group">
        <label for="maximumYear">Maximum Year of Study (blank = unrestricted)</label>
        <input type="number" min="1" max="6" id="maximumYear" name="maximumYear" value="${scholarship.maximumYear}">
    </div>
    <div class="form-group">
        <label for="genderEligibility">Gender Eligibility</label>
        <select id="genderEligibility" name="genderEligibility">
            <option value="ALL" ${scholarship.genderEligibility == 'ALL' ? 'selected' : ''}>All</option>
            <option value="MALE" ${scholarship.genderEligibility == 'MALE' ? 'selected' : ''}>Male Only</option>
            <option value="FEMALE" ${scholarship.genderEligibility == 'FEMALE' ? 'selected' : ''}>Female Only</option>
        </select>
    </div>
</div>
<div class="form-grid">
    <div class="form-group checkbox-row">
        <input type="checkbox" id="disabilityRequired" name="disabilityRequired" ${scholarship.disabilityRequired ? 'checked' : ''}>
        <label for="disabilityRequired" style="margin:0;">Requires disability status</label>
    </div>
    <div class="form-group checkbox-row">
        <input type="checkbox" id="minorityRequired" name="minorityRequired" ${scholarship.minorityRequired ? 'checked' : ''}>
        <label for="minorityRequired" style="margin:0;">Requires minority status</label>
    </div>
</div>

<h4>Dates &amp; Official Links</h4>
<div class="form-grid">
    <div class="form-group">
        <label for="applicationStartDate">Application Start Date</label>
        <input type="date" id="applicationStartDate" name="applicationStartDate" value="${scholarship.applicationStartDate}">
    </div>
    <div class="form-group">
        <label for="applicationDeadline">Application Deadline</label>
        <input type="date" id="applicationDeadline" name="applicationDeadline" data-required="true" required value="${scholarship.applicationDeadline}">
    </div>
</div>
<div class="form-group">
    <label for="applicationUrl">Official Application URL</label>
    <input type="text" id="applicationUrl" name="applicationUrl" data-required="true" required
           placeholder="https://scholarships.gov.in/" value="${scholarship.applicationUrl}">
    <div class="hint">Must be the scholarship provider's own official website — never a blog or search-result link.</div>
</div>
<div class="form-group">
    <label for="trackingUrl">Official Tracking URL (leave blank if not verified)</label>
    <input type="text" id="trackingUrl" name="trackingUrl" value="${scholarship.trackingUrl}">
</div>
